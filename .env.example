# ─────────── DENTOS muhit o'zgaruvchilari (NAMUNA) ───────────
# Haqiqiy qiymatlar bilan nusxa oling:  cp .env.example .env
# .env fayli git'ga TUSHMAYDI (maxfiy).

# ── Django ──
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=*

# ── PostgreSQL (Docker ichida) ──
POSTGRES_DB=dentos
POSTGRES_USER=dentos
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── Telegram (Telethon) API kalitlar — my.telegram.org dan ──
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ── Frontend → backend API manzili (build vaqtida yoziladi) ──
# Lokal: http://localhost:8000/api
# Serverda: https://domeningiz.uz/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api
