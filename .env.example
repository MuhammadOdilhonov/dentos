# Copy to .env on the server. Never commit real secrets.
DOMAIN=dentos.cc
BACKEND_DOMAIN=backend.dentos.cc
ACME_EMAIL=
SECRET_KEY=change-me-use-python-secrets-token-url-safe-64
DEBUG=False
ALLOWED_HOSTS=dentos.cc,backend.dentos.cc,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://dentos.cc
POSTGRES_DB=dentos
POSTGRES_USER=dentos
POSTGRES_PASSWORD=change-me-use-a-long-random-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
NEXT_PUBLIC_API_URL=/api
# Local until medical data residency/legal approval is documented.
# Real patient data must not be placed on an unapproved foreign server either.
MEDIA_STORAGE=local
B2_MEDICAL_STORAGE_APPROVED=false
B2_BUCKET_NAME=dentos
B2_REGION=eu-central-003
B2_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
B2_KEY_ID=
B2_APPLICATION_KEY=
MAX_PATIENT_FILE_BYTES=536870912
# Clinic Telegram account credentials from my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Existing login-only bot, never a patient-facing bot.
TELEGRAM_LOGIN_BOT_TOKEN=
TELEGRAM_LOGIN_BOT_USERNAME=dentosccbot
START_BACKGROUND_SERVICES=false

# ── Redis / Celery ──────────────────────────────────────────────────────────
# Compose ichida host 'redis'. Broker (db0) va natija (db1). Internetga ochilmaydi.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Gunicorn (api xizmati) ─────────────────────────────────────────────────────
# Telegram ALOHIDA xizmatda — shuning uchun api workerlarini ko'paytirsa bo'ladi.
# Yuklama testidan keyin CPU'ga qarab moslang (CX53 spec panelda tasdiqlanadi).
GUNICORN_WORKERS=3
GUNICORN_THREADS=4

# ── Backup shifrlash (deploy/backup.sh) ────────────────────────────────────────
# Arxiv age/offsite siyosati RUNBOOK'da. Shifrlash uchun parol (bo'sh bo'lsa shifrlamaydi —
# productionda TO'LDIRING). Faqat serverdagi .env'da, Git'ga tushmaydi.
BACKUP_ENCRYPTION_PASSPHRASE=

# ── Monitoring (deploy/monitoring) ──────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-strong
# Monitoring panellari faqat ichki yoki himoyalangan bo'lsin (RUNBOOK'ga qarang).
